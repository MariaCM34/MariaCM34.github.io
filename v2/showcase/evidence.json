        "sql_executed": "WITH sales AS (SELECT strftime(event_at, '%Y-%m') AS period, currency,\n sum(sales_minor) AS amount, count(*) AS row_count\nFROM fct_order_lines WHERE status = 'completed' AND event_at >= ? AND event_at < ? AND currency = ?\nGROUP BY 1, 2), returns AS (SELECT strftime(event_at, '%Y-%m') AS period, currency,\n sum(amount_minor) AS amount, count(*) AS row_count\nFROM fct_returns WHERE status = 'accepted' AND event_at >= ? AND event_at < ? AND currency = ?\nGROUP BY 1, 2),\n keys AS (SELECT period, currency FROM sales UNION SELECT period, currency FROM returns)\nSELECT keys.period, keys.currency,\n coalesce(sales.amount, 0) - coalesce(returns.amount, 0) AS value,\n coalesce(sales.row_count, 0) AS sales_rows, coalesce(returns.row_count, 0) AS return_rows\nFROM keys LEFT JOIN sales ON keys.period = sales.period AND keys.currency = sales.currency\nLEFT JOIN returns ON keys.period = returns.period AND keys.currency = returns.currency\nORDER BY 1, 2 LIMIT 500"
